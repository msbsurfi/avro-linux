const GLib = imports.gi.GLib;
const Gio = imports.gi.Gio;

function get_pkgdatadir() {
    return "@pkgdatadir@";
}

function get_libexecdir() {
    return "@libexecdir@";
}

function get_version() {
    return "@version@";
}

/**
 * Auto-discover XAUTHORITY in runtime dir if not set (vital for Wayland/XWayland).
 */
function ensure_xauthority() {
    if (!GLib.getenv("XAUTHORITY")) {
        try {
            let runtimeDir = GLib.getenv("XDG_RUNTIME_DIR") || ("/run/user/" + GLib.get_user_name());
            let d = Gio.File.new_for_path(runtimeDir);
            if (d.query_exists(null)) {
                let enumerator = d.enumerate_children("standard::name", Gio.FileQueryInfoFlags.NONE, null);
                let info;
                while ((info = enumerator.next_file(null)) !== null) {
                    let name = info.get_name();
                    if (name.indexOf("xauth_") === 0) {
                        GLib.setenv("XAUTHORITY", runtimeDir + "/" + name, true);
                        break;
                    }
                }
            }
        } catch (e) {}
    }
}

/**
 * Configure imports.searchPath to include all necessary module directories.
 * If baseDir is provided, uses that base; otherwise defaults to get_pkgdatadir().
 */
function init_search_paths(baseDir) {
    ensure_xauthority();
    let dir = baseDir || get_pkgdatadir();
    let paths = [
        dir,
        dir + "/common",
        dir + "/engine",
        dir + "/avro-core",
        dir + "/avro-core/phonetic",
        dir + "/avro-core/dictionary",
        dir + "/avro-core/autocorrect",
        dir + "/avro-core/suggestions",
        dir + "/preferences",
        dir + "/ui",
        // Source tree fallback layout
        dir + "/src",
        dir + "/src/common",
        dir + "/src/engine",
        dir + "/src/avro-core",
        dir + "/src/avro-core/phonetic",
        dir + "/src/avro-core/dictionary",
        dir + "/src/avro-core/autocorrect",
        dir + "/src/avro-core/suggestions",
        dir + "/src/preferences",
        dir + "/src/ui"
    ];

    for (let i = 0; i < paths.length; i++) {
        let p = paths[i];
        if (imports.searchPath.indexOf(p) === -1) {
            imports.searchPath.unshift(p);
        }
    }
}

