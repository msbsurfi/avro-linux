#!/bin/sh
# Launcher script for Avro Mouse
# SPDX-License-Identifier: MPL-2.0
# Remastered by MD Shifat Bin Siddique Urfi (DMC, K-79) and MD Mehedi Hasan (BUET, 2021-22)

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "${SCRIPT_DIR}/src/standalone/avromouse.js" ]; then
    exec gjs "${SCRIPT_DIR}/src/standalone/avromouse.js" "$@"
elif [ -f "/usr/share/avro-linux/standalone/avromouse.js" ]; then
    exec gjs /usr/share/avro-linux/standalone/avromouse.js "$@"
else
    echo "Error: avromouse.js not found" >&2
    exit 1
fi
