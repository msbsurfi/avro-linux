<?xml version="1.0" encoding="utf-8"?>
<!-- filename: ibus-avro.xml -->
<component>
	<name>org.freedesktop.IBus.Avro</name>
	<description>Avro Phonetic Bengali Input Method</description>
	<exec>@pkgdatadir@/engine/main-gjs.js --ibus</exec>
	<version>1.0.0</version>
	<author>Sarim Khan &lt;sarim2005@gmail.com&gt;</author>
	<license>MPL-2.0</license>
	<homepage>https://github.com/avro-linux/avro-linux</homepage>
	<textdomain>avro-linux</textdomain>

	<engines>
		<engine>
			<name>ibus-avro</name>
			<language>bn</language>
			<license>MPL-2.0</license>
			<author>Sarim Khan &lt;sarim2005@gmail.com&gt;</author>
			<icon>@pkgdatadir@/icons/avro-bangla.png</icon>
			<layout>us</layout>
			<longname>Avro Phonetic</longname>
			<description>Avro Phonetic Bengali Input Method</description>
			<setup>/usr/bin/env gjs @pkgdatadir@/preferences/pref.js --standalone</setup>
			<rank>99</rank>
		</engine>
	</engines>
</component>
