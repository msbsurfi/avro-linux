#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # 1. Set up universal environment variables across all desktop environments
    mkdir -p /etc/profile.d
    cat > /etc/profile.d/avro-linux.sh << 'EOF'
# Avro Linux — System-wide input method configuration
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
EOF
    chmod 0644 /etc/profile.d/avro-linux.sh

    # Systemd user environment.d
    mkdir -p /etc/environment.d
    cat > /etc/environment.d/99-avro-linux.conf << 'EOF'
GTK_IM_MODULE=ibus
QT_IM_MODULE=ibus
XMODIFIERS=@im=ibus
EOF
    chmod 0644 /etc/environment.d/99-avro-linux.conf

    # KDE Plasma environment
    mkdir -p /etc/xdg/plasma-workspace/env
    cat > /etc/xdg/plasma-workspace/env/avro-linux.sh << 'EOF'
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
EOF
    chmod 0755 /etc/xdg/plasma-workspace/env/avro-linux.sh

    # 2. XDG Autostart for non-GNOME desktops (KDE, XFCE, Cinnamon, MATE, LXQt)
    mkdir -p /etc/xdg/autostart
    cat > /etc/xdg/autostart/avro-ibus-autostart.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Avro Input Method Daemon
Comment=Starts IBus daemon for Avro Phonetic
Exec=ibus-daemon -drx
Terminal=false
NoDisplay=true
StartupNotify=false
X-GNOME-Autostart-enabled=true
Categories=Utility;
EOF
    chmod 0644 /etc/xdg/autostart/avro-ibus-autostart.desktop

    # 3. GNOME Input Sources schema override
    if [ -d /usr/share/glib-2.0/schemas ]; then
        cat > /usr/share/glib-2.0/schemas/99-avro-linux.gschema.override << 'EOF'
[org.gnome.desktop.input-sources]
sources=[('xkb', 'us'), ('ibus', 'ibus-avro')]
EOF
    fi

    # 4. Set Debian im-config to ibus
    if command -v im-config >/dev/null 2>&1; then
        im-config -n ibus 2>/dev/null || true
    fi

    # 5. Compile GSettings schemas
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas || true
    fi

    # 6. Update desktop database
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi

    # 7. Update icon caches
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi

    # 8. Update IBus component registry cache
    if command -v ibus >/dev/null 2>&1; then
        ibus write-cache --system 2>/dev/null || true
        ibus write-cache 2>/dev/null || true
    fi
fi

exit 0
